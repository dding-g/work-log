# ============================================================
# Work-Log Automation 환경 변수 설정
# ============================================================
#
# 사용 방법:
# 1. 이 파일을 .env로 복사: cp .env.example .env
# 2. .env 파일에서 필요한 값을 설정
# 3. 서버 실행 시 자동으로 로드됨
#

# ----- LLM API 키 (둘 중 하나만 설정하면 됨) -----

# OpenAI API 키 (GPT 사용 시)
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API 키 (Claude 사용 시)
# https://console.anthropic.com/ 에서 발급
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here


# ----- Slack 연동 (n8n에서 설정해도 됨) -----

# Slack Webhook URL
# https://api.slack.com/messaging/webhooks 참고
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ----- GitHub 연동 -----

# GitHub Personal Access Token (커밋 조회용)
GITHUB_TOKEN=ghp_xxxxxxx

# GitHub 저장소 정보
GITHUB_OWNER=ddingg
GITHUB_REPO=work-log


# ----- AWS 연동 (Lambda 환경에서 자동 설정) -----

# S3 버킷 이름 (업무일지 저장용)
S3_BUCKET_NAME=work-log-worklogs-xxx


# ----- 서버 설정 -----

# API 서버 포트 (기본값: 8000)
PORT=8000

# 환경 (development / production)
ENVIRONMENT=development
