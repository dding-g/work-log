# Work-Log Automation 설정 파일
# 이 파일을 config.env로 복사한 후 값을 설정하세요.

# ==================== 기본 설정 ====================

# 타임존 (기본값: Asia/Seoul)
TIMEZONE="Asia/Seoul"

# 업무일지 저장 디렉토리 (기본값: ./worklog)
# WORKLOG_DIR="/path/to/worklog"

# 대상 저장소 경로 (기본값: 현재 디렉토리)
# TARGET_REPO="/path/to/your/repo"

# 언어 설정 (ko 또는 en)
LANGUAGE="ko"

# ==================== Slack 설정 ====================

# Slack Incoming Webhook URL (필수)
# https://api.slack.com/messaging/webhooks 에서 생성
SLACK_WEBHOOK_URL=""

# Slack 채널 (기본값: #general)
SLACK_CHANNEL="#general"

# 봇 이름 (기본값: Work-Log Bot)
SLACK_USERNAME="Work-Log Bot"

# 봇 이모지 (기본값: :memo:)
SLACK_ICON_EMOJI=":memo:"

# ==================== 고급 설정 ====================

# 커밋 분석 시 무시할 파일 패턴 (쉼표로 구분)
# IGNORE_PATTERNS="*.lock,*.min.js,package-lock.json"

# 최대 커밋 분석 개수 (기본값: 무제한)
# MAX_COMMITS=50
